# Seva Sathi: Environment Configuration Example
# IMPORTANT: Use safe placeholders only. Never commit real secret keys.

# Supabase Persistence & Authentication (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Groq AI Assistant (Never expose to browser)
GROQ_API_KEY=your-groq-api-key-here

# Optional Multi-Channel Outreach Integrations (Server-side)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=SevaSathiBot
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
SMS_GATEWAY_API_KEY=your-sms-gateway-key
